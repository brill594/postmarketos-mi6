maintainer=""
pkgname=pd-mapper
pkgver=0_git20251230
pkgrel=0
pkgdesc="Qualcomm protection-domain service mapper for legacy kernels"
url="https://github.com/linux-msm/pd-mapper"
arch="aarch64"
license="BSD-3-Clause"
makedepends="qrtr-dev xz-dev"
subpackages="$pkgname-openrc"
# Upstream has no test suite.
options="!check"
_commit="5ecd2fe926aca7abfe40724177f63b942cff3947"
source="
	$pkgname-$_commit.tar.gz::https://github.com/linux-msm/pd-mapper/archive/$_commit.tar.gz
	pd-mapper.initd
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	make
}

package() {
	install -Dm755 pd-mapper "$pkgdir"/usr/sbin/pd-mapper
	install -Dm755 "$srcdir"/pd-mapper.initd "$pkgdir"/etc/init.d/pd-mapper
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

openrc() {
	install="$subpkgname.post-install"
	default_openrc
}

